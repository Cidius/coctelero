<?php
/**
 * Copiar este archivo a config.php y completar con los datos reales.
 * config.php NUNCA se sube al repo (esta en .gitignore).
 *
 * En Hostinger, config.php debe quedar FUERA de /public (por ejemplo en la
 * raiz del proyecto o en un nivel superior). El document root del hosting
 * apunta a /public, asi que config.php no es accesible por URL.
 */

return [
    'db' => [
        'host'    => 'localhost',
        'port'    => 3306,
        'name'    => 'coctelero',
        'user'    => 'root',
        'pass'    => '',
        'charset' => 'utf8mb4',
    ],

    // URL base del sitio, sin barra final. Dejar VACIO para autodetectar el
    // host del request (cambiar de dominio no requiere tocar esto). Completar
    // solo para forzar un host/protocolo fijo. Ej: https://cocteles.midominio.com
    'base_url' => '',

    // Ruta absoluta a la carpeta de imagenes subidas (servida por el hosting).
    'uploads_dir' => __DIR__ . '/uploads/recipes',
    // URL publica de esa carpeta, relativa a base_url.
    'uploads_url' => '/uploads/recipes',

    // Entorno: 'dev' muestra errores en pantalla, 'prod' los oculta y loguea.
    'env' => 'dev',

    // Login: intentos permitidos por IP antes del bloqueo temporal.
    'login_max_attempts' => 5,
    'login_lockout_minutes' => 15,

    // Google Sign-In (OAuth 2.0 / OpenID Connect) para las cuentas de
    // usuario publicas ("coctelero"). Crear en:
    //   https://console.cloud.google.com/apis/credentials
    // Tipo de credencial: "ID de cliente de OAuth" > Aplicacion web.
    'google' => [
        'client_id'     => '',
        'client_secret' => '',
        // Debe coincidir EXACTO (con protocolo, dominio y mayus/minus) con
        // un "URI de redireccionamiento autorizado" configurado en Google.
        'redirect_uri'  => '', // ej: https://coctelero.online/auth/google/callback.php
    ],

    // Notificacion por mail cuando llega un mensaje de contacto nuevo.
    // Usa la funcion mail() nativa de PHP (la que da el hosting). Si la
    // entrega no es confiable, el mensaje igual queda guardado en el panel.
    'mail' => [
        'admin_to'   => '',                             // a donde llega el aviso
        'from_email' => 'no-responder@coctelero.online', // remitente
        'from_name'  => 'El Coctelero Online',
    ],
];
