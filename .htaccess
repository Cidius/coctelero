# ================================================================
#  Recetario de Cocteles  -  reglas del sitio (raiz = public_html)
# ================================================================

AddDefaultCharset UTF-8
Options -Indexes

# ---- Headers de seguridad ----
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- Forzar HTTPS ----
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ---- Bloquear carpetas internas (no son parte del sitio publico) ----
    # src/ = codigo PHP, sql/ = esquema y datos, bin/ = scripts CLI
    RewriteRule ^(src|sql|bin)/ - [F,L]

    # ---- Sitemap ----
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# ---- Bloquear archivos sensibles / no publicos ----
<FilesMatch "(^config\.php$|\.(example|md|sql|docx|log|ini|sh|dist)$|^\.)">
    Require all denied
</FilesMatch>

# Fallback para Apache 2.2
<IfModule !mod_authz_core.c>
    <FilesMatch "(^config\.php$|\.(example|md|sql|docx|log|ini|sh|dist)$)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ---- PWA ----
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
# El service worker no debe cachearse en el navegador (asi toma actualizaciones)
<FilesMatch "^sw\.js$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </IfModule>
</FilesMatch>
